<?xml version="1.0" encoding="utf-8"?>
<!-- Rex's plain TCP listener speaks ws:// on the local network, at any address the user types. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
